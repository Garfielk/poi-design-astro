---
import MainLayout from '@/layouts/main.astro';
import ProductCategoryPage from "@/components/page/ProductCategory.tsx"
import type {Language} from "@/i18n/config.ts";
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  // 从内容集合获取所有产品图片清单
  const productImageCollections = await getCollection<'productImages'>('productImages');

  // 从图片路径中提取分类（目录结构）
  const categorySet = new Set<string>();
  const categoryProducts: Record<string, Array<{
    id: string;
    name: string;
    image: string;
    subcategory?: string;
  }>> = {};

  productImageCollections.forEach((entry) => {
    const pathParts = entry.id.split('/');

    if (pathParts.length === 0) {
      return;
    }

    const category = pathParts[0];
    const subPathParts = pathParts.slice(1, -1);
    const subcategory = subPathParts.length > 0 ? subPathParts.join('/') : undefined;

    categorySet.add(category);

    if (!categoryProducts[category]) {
      categoryProducts[category] = [];
    }

    entry.data.forEach(({ name, src }) => {
      const productId = src.replace(/\.[^/.]+$/, '');

      categoryProducts[category].push({
        id: productId,
        name,
        image: `/src/products/${src}`,
        subcategory,
      });
    });
  });

  const categories = Array.from(categorySet);
  const languages = [
    { param: undefined, lang: 'en' as Language },
    { param: 'zh-CN', lang: 'zh-CN' as Language },
  ];

  return languages.flatMap(({ param, lang }) =>
    categories.map(category => ({
      params: { lang: param, category },
      props: {
        lang,
        products: categoryProducts[category] || [],
        allCategories: categories,
      }
    }))
  );
}

const { lang, products, allCategories } = Astro.props as {
  lang: 'en' | 'zh-CN';
  products: Array<{id: string; name: string; image: string; subcategory?: string}>;
  allCategories: string[];
};
const { category } = Astro.params;
---

<MainLayout lang={lang}>
  <ProductCategoryPage
    lang={lang}
    category={category}
    products={products}
    allCategories={allCategories}
    client:load
  />
</MainLayout>
