---
import MainLayout from '@/layouts/main.astro';
import ProductCategoryPage, {type ProductItem} from "@/components/page/ProductCategory.tsx"
import type {Language} from "@/i18n/config.ts";
import { getCollection } from 'astro:content';

export const prerender = true;

type CategoryItem = {
  id: string;
  name: string;
  isSub?: boolean;
  children: Record<string, CategoryItem> | null;
  sort?: number;
};

export async function getStaticPaths() {
  const productImageCollections = await getCollection<'productImages'>('productImages');


  console.log(productImageCollections);

  // 从图片路径中提取分类（目录结构）
  const categorySet = new Set<string>();
  const categoryTree: Record<string, CategoryItem> = {}
  const categoryProducts: Record<string, ProductItem[]> = {};

  productImageCollections.forEach((entry) => {

    const pathParts = entry.id.split('/');
    const categoryName = entry.filePath?.split('/')[2]

    if (pathParts.length === 0) {
      return;
    }

    const category = pathParts[0];
    const subPathParts = pathParts.slice(1, -1);

    const {name, productImages, sort} = entry.data

    let subcategory = ''
    let midcategory = ''
    let isSub = false
    if (subPathParts.length === 0) return
    if (subPathParts.length === 1) subcategory = subPathParts[0]
    if (subPathParts.length === 2) {
      subcategory = `${subPathParts[0]}-${subPathParts[1]}`
      isSub = true
      midcategory = subPathParts[0]
    }

    categoryTree[category] = categoryTree[category] || { id: category, name: categoryName, children: {} };
    if (categoryTree[category].children === null) {
      categoryTree[category].children = {};
    }
    categoryTree[category].children![subcategory] = {
      id: subcategory,
      name: name,
      isSub,
      children: null,
      sort
    };

    categorySet.add(subcategory);

    if (!categoryProducts[subcategory]) {
      categoryProducts[subcategory] = [];
    }

    productImages.forEach(({ name, src }) => {
      const productId = src.replace(/\.[^/.]+$/, '');

      categoryProducts[subcategory].push({
        id: productId,
        name,
        image: `/products/${src}`,
        parent: category,
        categoryName: name
      });
    });
  });

  const categories = Array.from(categorySet);
  const languages = [
    { param: undefined, lang: 'en' as Language },
    { param: 'zh-CN', lang: 'zh-CN' as Language },
  ];

  return languages.flatMap(({param, lang}) =>
    categories.map(category => ({
      params: {lang: param, category},
      props: {
        lang,
        products: categoryProducts[category] || [],
        categoryTree
      }
    }))
  );
}

const { lang, products, categoryTree } = Astro.props as {
  lang: 'en' | 'zh-CN';
  products: ProductItem[];
  categoryTree: Record<string, CategoryItem>;
};
const { category } = Astro.params;
---

<MainLayout lang={lang}>
  <ProductCategoryPage
    lang={lang}
    category={category}
    products={products}
    categoryTree={categoryTree}
    client:load
  />
</MainLayout>
